int countStudents(int* students, int studentsSize, int* sandwiches, int sandwichesSize){
    int studentCnts[2] = {0, 0};
    for (int i = 0; i < studentsSize; i += 1){
        studentCnts[ students[i] ] += 1;
    }
    for (int i = 0; i < sandwichesSize && studentCnts[ sandwiches[i] ] > 0; i += 1){
        studentCnts[ sandwiches[i] ] -= 1;
    }
    return studentCnts[0] + studentCnts[1];
}
